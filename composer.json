{
    "name": "sdwa5/dolibarr-pmtools",
    "description": "Dolibarr module that adds ticket dictionary writes, ticket close, cancel and reopen to the REST API, and ticket and project tools to the core MCP server",
    "type": "dolibarr-module",
    "version": "1.0.0",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "platform": {
            "php": "8.1.31"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test-integration": "phpunit --testsuite integration"
    }
}
